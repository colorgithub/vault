# ---- 数据库连接（必填）----
#
# 部署到 Vercel 时这一项【不用手填】：在 Vercel 控制台 Storage / Integrations
# 里创建并连接 Neon 数据库后，Vercel 会自动注入 DATABASE_URL。
#
# 只有在本地开发、或手动连接外部数据库时才需要自己填。
# 本地示例：postgresql://postgres:postgres@localhost:5432/memo_vault
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 兼容说明：程序会按下面的顺序自动查找连接串，命中任意一个即可，无需全部配置
#   DATABASE_URL → POSTGRES_URL → POSTGRES_PRISMA_URL → DATABASE_URL_UNPOOLED
#   → POSTGRES_URL_NON_POOLING → NEON_DATABASE_URL
#   → 任意以 _DATABASE_URL 结尾的变量（如 PRIMARY_DATABASE_URL）
#   → 由 PGHOST / PGUSER / PGPASSWORD / PGDATABASE / PGPORT 拼装

# ---- 会话密钥（必填）----
#
# 随便一段长随机字符串即可。
# 生成命令： node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="请替换为一段足够长的随机字符串"

# ---- 可选 ----

# 站点名称，显示在浏览器标题与页头
NEXT_PUBLIC_APP_NAME="MemoVault"

# ---- OAuth 2.0 授权服务器（可选）----
#
# 配置后，其它应用（例如博客）就可以用「MemoVault 账号登录」，
# 而你不需要在博客里再存一份密码。
#
# OAUTH_CLIENTS 是一个 JSON 数组，每项包含：
#   clientId     客户端标识，自定义
#   clientSecret 客户端密钥，用随机串，且必须与客户端配置一致
#   name         授权页上显示的应用名
#   redirectUris 回调地址白名单，必须精确匹配（不做通配）
#   scopes       可选，默认 ["profile", "email"]
#
# 生成 clientSecret：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 不配置时，/oauth/authorize 会返回「未知的应用」，但不影响 MemoVault 自身使用。
OAUTH_CLIENTS='[{"clientId":"my-blog","clientSecret":"请替换为随机串","name":"我的博客","redirectUris":["https://blog.example.com/api/auth/oauth/callback"]}]'

# 对外 issuer。留空时按请求 origin 自动推断；
# 生产环境建议显式配置，避免从不同域名访问时 issuer 不一致。
OAUTH_ISSUER="https://vault.example.com"

