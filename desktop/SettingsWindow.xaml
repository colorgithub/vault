<Window x:Class="MemoVaultNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="432"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1117" />
            <Setter Property="Foreground" Value="#E8EBF2" />
            <Setter Property="BorderBrush" Value="#2A2F3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="#E8EBF2" />
            <Setter Property="SelectionBrush" Value="#3B82F6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B5563" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8E97A8" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#6B7385" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#F2F4F8" />
            <Setter Property="Foreground" Value="#111319" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AEB6C6" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#F2F4F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F213151C" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="22,18,22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="#F2F4F8" />
                <Button HorizontalAlignment="Right" Style="{StaticResource Ghost}" Padding="8,2"
                        Click="Cancel_Click" Content="✕" FontSize="11" />
            </Grid>

            <TextBlock Text="服务器地址" Style="{StaticResource Label}" />
            <TextBox x:Name="UrlBox" Style="{StaticResource Input}" />
            <TextBlock Text="例如 https://vault-indol-xi.vercel.app（不要带 /api）" Style="{StaticResource Hint}" />

            <TextBlock Text="API 密钥" Style="{StaticResource Label}" />
            <TextBox x:Name="KeyBox" Style="{StaticResource Input}" />
            <TextBlock Text="网页端 侧栏 → API 密钥 生成，以 mv_ 开头；只读，可随时撤销。"
                       Style="{StaticResource Hint}" />

            <TextBlock Text="刷新间隔" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IntervalBox" Style="{StaticResource Input}" Width="72" />
                <TextBlock Text="分钟" Foreground="#AEB6C6" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="（1 – 1440）" Foreground="#6B7385" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="同时显示" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="CountBox" Style="{StaticResource Input}" Width="72" />
                <TextBlock Text="张便签" Foreground="#AEB6C6" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="（1 – 10，按置顶与更新时间取前几条）" Foreground="#6B7385" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <CheckBox x:Name="TopmostBox" Content="窗口置顶" Foreground="#C7CDD9" FontSize="12" />
                <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Foreground="#C7CDD9" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="卡片不透明度" Style="{StaticResource Label}" Margin="0,16,0,6" />
            <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" SmallChange="0.05"
                    LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05" />

            <Border x:Name="TestBox" Background="#14FFFFFF" CornerRadius="8" Padding="10,8"
                    Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TestText" FontSize="11" Foreground="#AEB6C6" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,18,0,0">
                <Button HorizontalAlignment="Left" Content="测试连接" Style="{StaticResource Ghost}"
                        Click="Test_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="0,0,6,0" />
                    <Button Content="保存" Style="{StaticResource Primary}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
