<Window x:Class="MemoVaultNote.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemoVault 便签"
        Width="380"
        SizeToContent="Height"
        MaxHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#98A1B2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#F2F4F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="16"
            Background="#E613151C"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            Padding="18,16,18,14"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="MenuHide" Header="隐藏这张便签" Click="Hide_Click" />
                <MenuItem x:Name="MenuShowAll" Header="显示全部便签" Click="ShowAll_Click" />
                <Separator />
                <MenuItem x:Name="MenuRefresh" Header="刷新" Click="Refresh_Click" />
                <MenuItem x:Name="MenuSettings" Header="设置…" Click="Settings_Click" />
                <Separator />
                <MenuItem x:Name="MenuTopmost" Header="窗口置顶" IsCheckable="True" Click="Topmost_Click" />
                <MenuItem Header="退出" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="便签"
                           FontSize="12"
                           Foreground="#8E97A8"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                            Click="Refresh_Click" ToolTip="立即刷新">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                            Click="Settings_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                            Click="Exit_Click" ToolTip="关闭所有便签并退出">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TitleText"
                       Margin="0,10,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#F2F4F8"
                       TextWrapping="Wrap"
                       Text="加载中…" />

            <ScrollViewer x:Name="BodyScroll"
                          Margin="0,8,0,0"
                          MaxHeight="240"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="BodyText"
                           FontSize="13"
                           LineHeight="21"
                           Foreground="#C7CDD9"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <TextBlock x:Name="ErrorText"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="#FB7185"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Grid Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#1FFFFFFF" CornerRadius="999" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ColorDot" Width="6" Height="6" Fill="#94A3B8"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="便签" FontSize="11" Foreground="#AEB6C6" />
                        </StackPanel>
                    </Border>
                    <Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="#6B7385"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="MetaText"
                           FontSize="11"
                           Foreground="#7C8494"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
